# Frontend (Vite). Safe for the browser: NO credentials or API secrets.
# /api is proxied to the standalone backend during `npm run dev`.
VITE_API_BASE_URL=/api
# Optional absolute backend origin (no /api suffix). Keep BLANK for Vite/Render reverse-proxy.
# For separate AWS custom domains e.g. https://api.example.com, set this and allow
# the frontend origin in backend WEB_ORIGIN/WEB_ORIGINS. Requires cross-origin CSRF/cookie setup.
VITE_BACKEND_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000
VITE_APP_TITLE=Bitstek Workspace
VITE_DEMO_MODE=false

# Optional hosted tenant domain. Keep blank on localhost.
VITE_SAAS_BASE_DOMAIN=
