# Copy to apps/web/.env.production when preparing a production build.
# All VITE_ vars are public. Never store secrets here.
VITE_API_BASE_URL=/api
# Only for direct frontend -> backend API calls; leave empty for /api proxy deployment.
VITE_BACKEND_URL=
VITE_APP_TITLE=Bitstek Workspace
VITE_DEMO_MODE=false
