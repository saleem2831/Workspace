{
  "name": "bitstek-workspace-backend",
  "version": "6.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "node scripts/seed-disabled.mjs",
    "migrate:v4": "tsx src/migrations/v4.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "health": "node scripts/health-check.mjs",
    "smoke": "node ../scripts/smoke.mjs",
    "migrate:v5": "tsx src/migrations/v5.ts",
    "doctor:security": "node ../scripts/repair-security-env.mjs",
    "migrate:v5.1": "tsx src/migrations/v5_1.ts",
    "test:security-setup": "node --test ../scripts/tests/security-repair.test.mjs",
    "migrate:v5.5": "tsx src/migrations/v5_5.ts",
    "migrate:v5.5:dry": "tsx src/migrations/v5_5.ts --dry-run",
    "migrate:v5.7": "tsx src/migrations/v5_7.ts",
    "migrate:saas:dry": "tsx src/migrations/v6_1_saas.ts",
    "migrate:saas:apply": "tsx src/migrations/v6_1_saas.ts --apply",
    "bootstrap:platform": "tsx src/saas/bootstrap-platform.ts",
    "bootstrap:platform:apply": "tsx src/saas/bootstrap-platform.ts --apply",
    "bootstrap:new:dry": "tsx src/saas/bootstrap-new-tenant.ts",
    "bootstrap:new:apply": "tsx src/saas/bootstrap-new-tenant.ts --apply",
    "migrate:storage:dry": "tsx src/migrations/v6_1_storage.ts",
    "migrate:storage:apply": "tsx src/migrations/v6_1_storage.ts --apply",
    "test:saas": "tsx --test src/tests/platform-migration.test.ts",
    "migrate:v5.7:dry": "tsx src/migrations/v5_7.ts --dry-run",
    "audit:v5.7:links": "tsx src/migrations/v5_7_audit_links.ts",
    "migrate:database:dry": "tsx src/saas/migrate-database.ts",
    "migrate:database:apply": "tsx src/saas/migrate-database.ts --apply",
    "migrate:database:verify": "tsx src/saas/migrate-database.ts --verify",
    "migrate:storage-provider:dry": "tsx src/saas/migrate-storage.ts",
    "migrate:storage-provider:apply": "tsx src/saas/migrate-storage.ts --apply",
    "migrate:storage-provider:verify": "tsx src/saas/migrate-storage.ts --verify",
    "bootstrap:demo:dry": "tsx src/saas/bootstrap-demo-roles.ts",
    "bootstrap:demo:apply": "tsx src/saas/bootstrap-demo-roles.ts --apply",
    "bootstrap:platform-owner:new:dry": "tsx src/saas/bootstrap-dedicated-platform-owner.ts",
    "bootstrap:platform-owner:new:apply": "tsx src/saas/bootstrap-dedicated-platform-owner.ts --apply"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "multer": "^2.0.2",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "archiver": "^7.0.1",
    "zod": "^3.24.2",
    "mongodb": "^6.18.0",
    "bson": "^6.10.4",
    "@aws-sdk/lib-storage": "^3.821.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.9",
    "@types/multer": "^1.4.12",
    "@types/archiver": "^6.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "description": "Single Express API for all Bitstek Workspace modules",
  "engines": {
    "node": ">=20.19.0"
  }
}
