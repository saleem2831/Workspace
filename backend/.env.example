# Backend only: never put these values inside frontend/.env.
NODE_ENV=development
PORT=5000
# Must support replica set transactions (MongoDB Atlas or local rs0).
MONGODB_URI=mongodb://127.0.0.1:27017/bitstek_workspace?replicaSet=rs0
WEB_ORIGIN=http://localhost:5173
# Optional extra EXACT browser origins, comma-separated; never use wildcard (*).
# Use for an additional staging frontend or AWS custom frontend hostname.
WEB_ORIGINS=
# lax works for same-origin proxy and https://app.example.com -> https://api.example.com
# (same site); none requires COOKIE_SECURE=true and may be blocked as a 3rd party cookie.
COOKIE_SAMESITE=lax
MFA_ENCRYPTION_KEY=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SEED_ADMIN_EMAIL=admin@bitstek.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-demo-password
COOKIE_SECURE=false
TRUST_PROXY=false

# Local private document storage (configure durable private volume in production)
UPLOAD_DIR=./private-uploads

# SaaS v6.1: set to s3 in staging/production; local allowed only for development
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional SSE-KMS CMK. If not set, S3 SSE-S3 encryption is requested.
S3_KMS_KEY_ID=
# Only used for future LLM features. Never send tenant files to AI by default.
OPENAI_API_KEY=
# Bootstrap existing Bitstek tenant using CLI dry-run first
SAAS_INITIAL_TENANT_SLUG=bitstek
# Platform bootstrap CLI: user must exist and have enrolled MFA
PLATFORM_OPERATOR_EMAIL=

# Empty database ONLY (not used for existing v5.7 customers)
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TENANT_SLUG=my-workspace

# v6.2 Platform Owner: bootstrap this privilege only for an MFA-enrolled account.
PLATFORM_OPERATOR_LEVEL=operator
# Offline whole MongoDB transfer. Point to an EMPTY target database.
DB_MIGRATION_TARGET_URI=
DB_MIGRATION_CONFIRM=
# Offline S3 -> S3 / S3-compatible transfers: never supply these through web forms.
STORAGE_MIGRATION_SOURCE_BUCKET=
STORAGE_MIGRATION_SOURCE_REGION=ap-south-1
STORAGE_MIGRATION_SOURCE_ENDPOINT=
STORAGE_MIGRATION_SOURCE_PATH_STYLE=false
STORAGE_MIGRATION_SOURCE_ACCESS_KEY_ID=
STORAGE_MIGRATION_SOURCE_SECRET_ACCESS_KEY=
STORAGE_MIGRATION_TARGET_BUCKET=
STORAGE_MIGRATION_TARGET_REGION=ap-south-1
STORAGE_MIGRATION_TARGET_ENDPOINT=
STORAGE_MIGRATION_TARGET_PATH_STYLE=false
STORAGE_MIGRATION_TARGET_ACCESS_KEY_ID=
STORAGE_MIGRATION_TARGET_SECRET_ACCESS_KEY=
STORAGE_MIGRATION_PREFIX=
STORAGE_MIGRATION_CONFIRM=
STORAGE_MIGRATION_REPORT_PATH=storage-migration-report.json
# To activate an S3-compatible storage backend after a verified transfer:
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=
# Optional disposable test users; NEVER enable in production.
DEMO_BOOTSTRAP_CONFIRM=

# v6.2.1: Provision a NEW, separate Platform Owner identity on an existing SaaS tenant
# Run only in trusted interactive terminal with verified backup; do not commit secrets.
PLATFORM_OWNER_NEW_EMAIL=
PLATFORM_OWNER_NEW_NAME=Platform Owner
PLATFORM_OWNER_CREATE_CONFIRM=

# Optional wildcard SaaS hostname, e.g. workspace.example.com (requires DNS + TLS + proxy)
SAAS_BASE_DOMAIN=
