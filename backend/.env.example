# Do not commit actual credentials. Copy to .env for local development only.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bitstek_workspace?replicaSet=rs0
JWT_SECRET=replace-with-strong-random-secret-of-32-or-more-characters
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
SERVE_FRONTEND=false
STORAGE_BACKEND=local
